<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flores para ti 🌻</title>

    <!-- Fuente -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Fondo -->
    <div class="fondo" id="fondo">

        <!-- Estrellas -->
        <div class="estrellas" id="estrellas"></div>

        <!-- Partículas -->
        <div id="particulas"></div>

        <!-- Título -->
        <div class="titulo">
            <h1>Para ti 🌻</h1>
            
        </div>

        <!-- Escena -->
        <main class="escena">

            <!-- Sobre -->
            <div class="sobre" id="sobre">

                <!-- Cuerpo del sobre -->
                <div class="cuerpo-sobre"></div>

                <!-- Carta -->
                <div class="carta" id="carta">

                    <div class="contenido-carta">
                        <span class="flor-icono">🌻</span>

                        <h2>Una carta para ti</h2>

                        <p id="textoCarta"></p>

                        <div class="firma">
                            Con mucho cariño 💛
                        </div>
                    </div>

                </div>

                <!-- Tapa del sobre -->
                <div class="tapa"></div>

                <!-- Sello -->
                <div class="sello" id="sello">💛</div>

            </div>

        </main>

        <!-- Botones -->
        <div class="controles">

            <button id="abrir">
                💌 Abrir carta
            </button>

            <button id="flores">
                🌻 Más flores
            </button>

            <button id="corazones">
                💛 Corazones
            </button>

            <button id="noche">
                🌙 Modo noche
            </button>

        </div>

        <!-- Flores -->
        <div id="floresContainer"></div>

        <!-- Corazones -->
        <div id="corazonesContainer"></div>

        <!-- Mensaje inferior -->
        <div class="mensaje-inferior">
            <span>Haz clic en cualquier parte de la pantalla ✨</span>
        </div>

    </div>

    <script src="script.js"></script>

</body>
</html>
